# Container Registry (for pre-built images)
# VERSION=latest
# VERSION=v1.0.0  # Pin to specific version
GITHUB_REPOSITORY=your-org/sentinel

# Database (internal Docker network)
DB_PASSWORD=changeme
DATABASE_URL=postgresql://sentinel:changeme@postgres:5432/sentinel


# Security Keys (auto-generated by setup.sh)
ENCRYPTION_KEY=
SESSION_SECRET=
PROXY_API_KEY=

# URLs (IMPORTANT: Change these for production deployments)
# API_URL is used for OAuth callback redirects - must match your deployment domain
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost

# Server
PORT=3000
NODE_ENV=production

# Optional: MCP/A2A Proxies
MCP_PORT=3001
A2A_PORT=3002

# TLS Configuration (for docker-compose.tls.yml or docker-compose.caddy.yml)
# DOMAIN=sentinel.yourdomain.com
# ACME_EMAIL=admin@yourdomain.com
# TLS_CERT_FILE=./certs/cert.pem
# TLS_KEY_FILE=./certs/key.pem

# Optional: Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Sentinel <notifications@yourdomain.com>"

# =============================================================================
# LLM Configuration
# =============================================================================
# These are the default/fallback LLM settings. Organizations can override these
# in Settings > AI / LLM with their own provider, model, and API keys.
#
# Priority: Org Settings (in DB) > Environment Variables

# Deployment Mode
# - "self-hosted": All providers available (cloud + local like Ollama, LM Studio)
# - "managed": Only cloud providers (OpenAI, Claude, Gemini) - for SaaS deployments
DEPLOYMENT_MODE=self-hosted

# Provider Priority (when org has "auto" selected):
# OpenAI (primary) > Claude > Gemini
# The first provider with a valid API key will be used.

# OpenAI API key - https://platform.openai.com
OPENAI_API_KEY=

# Anthropic Claude API key - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini API key - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Default model (optional - each provider has sensible defaults)
# Examples: gpt-5.2, claude-sonnet-4-5-20250514, gemini-2.5-flash
# LLM_MODEL=

# Max tokens per response (default: 4096)
LLM_MAX_TOKENS=4096
