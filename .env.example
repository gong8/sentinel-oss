# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/sentinel"
# Test database (optional, for running tests)
# TEST_DATABASE_URL="postgresql://user:pass@localhost:5432/sentinel_test"

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="your-32-byte-hex-string-for-aes-256-encryption-here"

# Server
PORT=3000
NODE_ENV=development

# CORS (frontend URL)
FRONTEND_URL="http://localhost:5173"

# MCP Server
MCP_PORT=3001
# MCP_PUBLIC_URL="https://your-mcp-server.com"  # Optional: public URL for MCP server

# A2A Server (Agent-to-Agent protocol)
A2A_PORT=3002

# Admin MCP Server (for admin operations via MCP clients like Cursor/Claude Code)
ADMIN_MCP_PORT=3003

# API_URL is used for OAuth callback redirects (API_URL + "/api/oauth/callback")
# If API_URL is not set, OAuth redirects will default to localhost:3000
# API_URL="http://localhost:3000"

# OAUTH_CALLBACK_URL - Only set this to override the auto-derived callback URL
# OAUTH_CALLBACK_URL="http://localhost:3000/api/oauth/callback"

# Session (generate with: openssl rand -hex 32)
SESSION_SECRET="your-session-secret-here"

# Proxy API Key (service-to-service auth between MCP proxy and API)
# Generate with: openssl rand -hex 32
PROXY_API_KEY=""

# Email Configuration (for EMAIL webhook type)
# Resend API - https://resend.com (get API key from dashboard)
RESEND_API_KEY=""
# Sender email address (must be verified domain in Resend, or use onboarding@resend.dev for testing)
EMAIL_FROM="Sentinel <notifications@yourdomain.com>"

# =============================================================================
# LLM Configuration
# =============================================================================
# These are the default/fallback LLM settings. Organizations can override these
# in Settings > AI / LLM with their own provider, model, and API keys.
#
# Priority: Org Settings (in DB) > Environment Variables

# Deployment Mode
# - "self-hosted": All providers available (cloud + local like Ollama, LM Studio)
# - "managed": Only cloud providers (OpenAI, Claude, Gemini) - for SaaS deployments
DEPLOYMENT_MODE="self-hosted"

# Provider Priority (when org has "auto" selected):
# OpenAI (primary) > Claude > Gemini
# The first provider with a valid API key will be used.

# OpenAI API key - https://platform.openai.com
OPENAI_API_KEY=""

# Anthropic Claude API key - https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Google Gemini API key - https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Default model (optional - each provider has sensible defaults)
# Examples: gpt-5.2, claude-sonnet-4-5-20250514, gemini-2.5-flash
# LLM_MODEL=""

# Max tokens per response (default: 4096)
# LLM_MAX_TOKENS="4096"

