{
  "name": "sentinel",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Control Plane for AI Agent Tooling",
  "scripts": {
    "setup": "pnpm install && pnpm db:generate && pnpm db:push && pnpm db:seed",
    "configure": "npx tsx scripts/configure.ts",
    "logs": "npx tsx scripts/logs.ts",
    "reset": "npx tsx scripts/reset.ts",
    "usage": "npx tsx scripts/help.ts",
    "backup": "npx tsx scripts/backup.ts",
    "restore": "npx tsx scripts/restore.ts",
    "validate-env": "npx tsx scripts/validate-env.ts",
    "dev": "pnpm kill && turbo run dev --filter=!@sentinel/a2a --filter=!@sentinel/db",
    "dev:verbose": "cross-env PRISMA_LOG=verbose pnpm dev",
    "dev:full": "pnpm kill && turbo run build --filter=@sentinel/db --filter=@sentinel/a2a && turbo run dev --filter=!@sentinel/a2a --filter=!@sentinel/db",
    "build": "turbo run build",
    "build:no-cache": "pnpm --filter @sentinel/db build && pnpm --filter @sentinel/api build && pnpm --filter @sentinel/web build",
    "db:generate": "turbo run db:generate",
    "db:generate:no-cache": "pnpm --filter @sentinel/db db:generate",
    "db:migrate": "pnpm --filter @sentinel/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @sentinel/db db:migrate:deploy",
    "db:push": "pnpm --filter @sentinel/db db:push",
    "db:reset": "pnpm --filter @sentinel/db db:reset",
    "db:reset:seed": "pnpm --filter @sentinel/db db:reset:seed",
    "db:reset:force": "pnpm --filter @sentinel/db db:reset:force",
    "db:init": "pnpm --filter @sentinel/db db:init",
    "db:clear": "pnpm --filter @sentinel/db db:clear",
    "db:clear:seed": "pnpm --filter @sentinel/db db:clear:seed",
    "db:studio": "pnpm --filter @sentinel/db db:studio",
    "db:seed": "pnpm --filter @sentinel/db db:seed",
    "db:creds": "pnpm --filter @sentinel/db db:creds",
    "db:seed:creds": "pnpm --filter @sentinel/db db:seed:creds",
    "db:reset:seed:creds": "pnpm --filter @sentinel/db db:reset:seed:creds",
    "seed": "pnpm db:reset:seed:creds",
    "lint": "pnpm --parallel --recursive lint",
    "lint:fix": "pnpm --recursive lint --fix",
    "lint:staged": "lint-staged",
    "typecheck": "pnpm --parallel --recursive exec tsc --noEmit",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:write": "pnpm format",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "test": "pnpm test:clean && pnpm test:unit && pnpm test:integration && pnpm test:security && pnpm test:e2e && pnpm test:summary",
    "test:vitest": "vitest run",
    "test:unit": "cross-env TEST_TYPE=unit vitest run --project unit",
    "test:integration": "cross-env TEST_TYPE=integration vitest run --project integration",
    "test:security": "cross-env TEST_TYPE=security vitest run --project security",
    "test:e2e": "playwright test --config test/setup/playwright.config.ts",
    "test:regression": "cross-env TEST_TYPE=regression vitest run test/regression",
    "test:performance": "cross-env TEST_TYPE=performance vitest run test/performance",
    "test:clean": "node -e \"require('fs').rmSync('test/results', {recursive: true, force: true})\"",
    "test:summary": "npx tsx test/reporters/summary.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:all": "pnpm test && pnpm test:e2e",
    "check": "node scripts/check.cjs",
    "check:quality": "node scripts/check-quality.cjs",
    "check:format": "echo 🎨 Checking code formatting... && pnpm format:check",
    "check:lint": "echo 🔍 Running linters... && pnpm lint",
    "check:types": "echo 📘 Type checking TypeScript... && pnpm typecheck",
    "check:test": "echo 🧪 Checking test code quality... && pnpm check:test:quality && pnpm check:test:lint && pnpm check:test:types",
    "check:test:quality": "node scripts/check-test-quality.cjs",
    "check:test:lint": "echo   🔍 Linting test files... && eslint test/",
    "check:test:types": "echo   📘 Type checking test files... && tsc --noEmit -p test/tsconfig.json",
    "check:build": "echo 🏗️  Building packages... && pnpm build",
    "check:tests": "pnpm test:clean && echo '🧪 Running tests...' && pnpm test:unit && pnpm test:integration && pnpm test:security && pnpm test:e2e && pnpm test:summary",
    "check:quick": "pnpm check:format && pnpm check:lint && pnpm check:types && pnpm check:test",
    "clean": "pnpm --recursive exec node -e \"['dist','node_modules','.turbo'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "kill": "node scripts/kill-ports.js",
    "prepare": "husky",
    "claude": "claude --dangerously-skip-permissions"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@playwright/test": "^1.57.0",
    "@trpc/server": "^11.8.1",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "cross-env": "^10.1.0",
    "dax-sh": "^0.44.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "hono": "^4.11.3",
    "husky": "^9.1.7",
    "jose": "^6.1.3",
    "kill-port": "^2.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "keywords": [
    "mcp",
    "ai",
    "control-plane",
    "policy-enforcement"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ],
    "patchedDependencies": {
      "prisma@7.2.0": "patches/prisma@7.2.0.patch"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "uuid": "^13.0.0"
  }
}
