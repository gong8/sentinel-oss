{
  "name": "@sentinel/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- pnpm exec vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@hono/node-server": "^1.19.7",
    "@hono/trpc-server": "^0.4.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@sentinel/a2a": "workspace:*",
    "@sentinel/db": "workspace:*",
    "@sentinel/shared": "workspace:*",
    "@trpc/server": "^11.8.1",
    "bcryptjs": "^3.0.3",
    "hono": "^4.11.3",
    "jose": "^6.1.3",
    "openai": "^6.17.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.34.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.0.3",
    "nodemon": "^3.1.11",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
