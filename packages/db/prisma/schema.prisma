// ============================================================================
// SENSITIVE TOOL FLAGS
// ============================================================================

enum SensitiveFlagBehavior {
  REQUIRE_APPROVAL // Block until approved by session owner or admin
  RATE_LIMIT // Enforce per-session rate limits
  ALERT // Send webhook notification
  // Note: Enhanced audit is now always-on for all sensitive flags
}

model SensitiveToolFlag {
  id             String                  @id @default(cuid())
  organizationId String
  toolPattern    String // e.g., "github.com::*", "localhost:3012::submit_backtest"
  behaviors      SensitiveFlagBehavior[]

  // Behavior configs (JSON)
  rateLimitConfig Json? // { maxPerSession: 5, windowMinutes: 60 }
  approvalConfig  Json? // { allowedApprovers: ["session_owner", "admin"], timeoutSeconds: 300 }
  alertConfig     Json? // { webhookEndpointIds: ["abc"] }

  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  // Workspace scoping (null = org-wide flag)
  workspaceId String?

  // Relations
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?                   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  creator        User?                        @relation("SensitiveFlagCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  agentOverrides SensitiveFlagAgentOverride[]

  @@unique([organizationId, workspaceId, toolPattern])
  @@index([organizationId, enabled])
  @@index([workspaceId])
}

model SensitiveFlagAgentOverride {
  id                  String @id @default(cuid())
  sensitiveToolFlagId String
  agentId             String

  behaviors       SensitiveFlagBehavior[] // Empty array = inherit from parent flag
  rateLimitConfig Json?
  approvalConfig  Json?
  exempted        Boolean                 @default(false) // Skip flag entirely for this agent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sensitiveToolFlag SensitiveToolFlag @relation(fields: [sensitiveToolFlagId], references: [id], onDelete: Cascade)
  agent             Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([sensitiveToolFlagId, agentId])
  @@index([agentId])
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CANCELLED
}

enum ApprovalType {
  SENSITIVE_FLAG
}

model SensitiveFlagApprovalRequest {
  id             String  @id @default(cuid())
  organizationId String
  sessionId      String
  userId         String
  agentId        String?
  toolName       String
  parameters     Json // Sanitized (secrets redacted)

  // Workspace scoping (null = org-wide request)
  workspaceId String?

  type   ApprovalType          @default(SENSITIVE_FLAG)
  status ApprovalRequestStatus @default(PENDING)

  // Resolution
  approvedBy   String?
  approvedAt   DateTime?
  deniedReason String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user         User         @relation("ApprovalRequestor", fields: [userId], references: [id], onDelete: Cascade)
  approver     User?        @relation("ApprovalApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, type, status])
  @@index([sessionId])
  @@index([userId, status])
  @@index([expiresAt])
}

model SensitiveFlagRateLimitUsage {
  id              String   @id @default(cuid())
  organizationId  String
  sessionId       String
  toolPattern     String
  windowStart     DateTime
  windowEnd       DateTime
  invocationCount Int      @default(0)
  lastInvocation  DateTime

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([sessionId, toolPattern, windowStart])
  @@index([windowEnd])
}

// ============================================================================
// WEBHOOK INFRASTRUCTURE
// ============================================================================

enum WebhookEvent {
  // Tool invocation events
  TOOL_INVOCATION_ALLOWED
  TOOL_INVOCATION_DENIED

  // Sensitive flag events
  SENSITIVE_TOOL_INVOKED
  SENSITIVE_APPROVAL_NEEDED
  SENSITIVE_RATE_LIMITED

  // Policy events
  POLICY_CREATED
  POLICY_UPDATED
  POLICY_DELETED

  // Agent events
  AGENT_CREATED
  AGENT_DELETED
  SESSION_TERMINATED // Admin-initiated session termination
}

enum WebhookEndpointType {
  CUSTOM // Raw JSON payload - user provides URL, we send JSON with HMAC signature
  DISCORD // Discord webhook - formatted embeds
  SLACK // Slack webhook - formatted blocks
  EMAIL // Email notification - formatted HTML
}

model WebhookEndpoint {
  id             String              @id @default(cuid())
  organizationId String

  // Workspace scoping (null = org-wide webhook)
  workspaceId String?

  name String
  type           WebhookEndpointType @default(CUSTOM)
  url            String? // CUSTOM/DISCORD/SLACK: webhook URL. EMAIL: not used
  events         WebhookEvent[]
  secret         String? // CUSTOM: HMAC secret. Others: empty/unused
  enabled        Boolean             @default(true)
  config         Json? // Type-specific config (email recipients, etc.)
  verbose        Boolean             @default(false) // Include detailed context in webhook payloads

  // Retry configuration
  maxRetries   Int @default(3)
  retryDelayMs Int @default(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relations
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  @@index([organizationId, enabled])
  @@index([workspaceId])
}

model WebhookDelivery {
  id         String       @id @default(cuid())
  endpointId String
  event      WebhookEvent
  payload    Json

  // Delivery status
  responseStatus Int?
  responseBody   String?
  deliveredAt    DateTime?
  failedAt       DateTime?
  retryCount     Int       @default(0)
  nextRetryAt    DateTime?

  createdAt DateTime @default(now())

  // Relations
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([nextRetryAt])
}

// ============================================================================
// AGENT ASSISTANT (AI-Powered Admin Chat)
// ============================================================================

model AgentConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String? // Dashboard user (null for MCP agent)
  mcpAgentId     String? // External MCP agent (null for dashboard user)
  title          String? // Auto-generated or user-set
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AgentMessage[]
  confirmations AgentConfirmation[]

  @@index([organizationId, userId])
  @@index([organizationId, mcpAgentId])
  @@index([createdAt])
}

enum AgentMessageRole {
  USER
  ASSISTANT
  TOOL_USE
  TOOL_RESULT
}

model AgentMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           AgentMessageRole
  content        String // Text content or tool call description
  toolName       String? // Tool name if TOOL_USE or TOOL_RESULT
  toolInput      Json? // Tool input parameters
  toolResult     Json? // Tool result data
  createdAt      DateTime         @default(now())

  // Relations
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

enum AgentConfirmationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model AgentConfirmation {
  id             String  @id @default(cuid())
  organizationId String
  conversationId String? // For dashboard chat
  mcpSessionId   String? // For MCP access
  workspaceId    String? // Workspace context for scoped operations

  // The proposed action
  toolName    String // Tool to execute (e.g., "create_policy")
  toolInput   Json // Input parameters for the tool
  description String // Human-readable description of the action

  // Status tracking
  status AgentConfirmationStatus @default(PENDING)

  // Result (after confirmation)
  confirmedAt DateTime?
  confirmedBy String? // User ID who confirmed
  executedAt  DateTime?
  result      Json? // Result from tool execution
  error       String? // Error message if execution failed

  // Lifecycle
  createdAt DateTime @default(now())
  expiresAt DateTime // Auto-expire after TTL (e.g., 5 minutes)

  // Relations
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace    Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([conversationId])
  @@index([expiresAt])
  @@index([workspaceId])
}

// ============================================================================
// AGENT MEMORY (Persistent context for AI agent)
// ============================================================================

enum AgentMemoryType {
  CONVERSATION_SUMMARY // Summarized past conversations
  USER_PREFERENCE // Preferred tools, patterns
  ENTITY_REFERENCE // Policies, servers, users mentioned
  TOOL_USAGE_PATTERN // Learned tool patterns
  CORRECTION // User corrections to agent behavior
}

model AgentMemory {
  id             String  @id @default(cuid())
  organizationId String
  userId         String? // null = org-wide memory

  memoryType AgentMemoryType
  category   String // e.g., "tool_preference", "entity:policy"
  key        String // Unique within category (e.g., tool name, entity id)

  content Json // Structured memory content
  summary String? // Human-readable summary for quick retrieval

  // Importance and access tracking for decay/pruning
  importance     Float    @default(0.5) // 0.0 to 1.0, decays over time
  accessCount    Int      @default(0)
  lastAccessedAt DateTime @default(now())

  // Lifecycle
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime? // Optional expiration

  // Source conversation (if applicable)
  sourceConversationId String?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, category, key])
  @@index([organizationId, memoryType])
  @@index([organizationId, userId, category])
  @@index([importance])
  @@index([lastAccessedAt])
}

model AgentToolUsage {
  id             String  @id @default(cuid())
  organizationId String
  userId         String? // null = org-wide pattern

  toolName        String
  contextKeywords String[] // Keywords that triggered this tool
  success         Boolean // Whether the tool call was successful

  createdAt DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, toolName])
  @@index([organizationId, userId, toolName])
  @@index([createdAt])
}

// Tool embedding cache for semantic tool selection
model ToolEmbeddingCache {
  id             String  @id @default(cuid())
  organizationId String? // null = admin/built-in tools

  toolName       String
  description    String  @db.Text // Tool description used for embedding
  embedding      Float[] // Vector embedding (e.g., 1536 dimensions for OpenAI)
  embeddingModel String // Model used to generate embedding (e.g., "text-embedding-3-small")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, toolName])
  @@index([organizationId])
}

// ============================================================================
// AGENT PLANNING (Multi-Step Operations)
// ============================================================================

enum AgentPlanStatus {
  DRAFT // Plan generated, awaiting approval
  PENDING // Approved, waiting to start
  EXECUTING // Currently running
  PAUSED // Paused mid-execution
  COMPLETED // All steps finished successfully
  FAILED // A step failed
  ABORTED // User cancelled
  ROLLED_BACK // Rolled back after failure
}

enum AgentPlanStepStatus {
  PENDING // Not yet started
  WAITING // Waiting for dependencies
  CONFIRMING // Awaiting user confirmation (for write operations)
  EXECUTING // Currently running
  COMPLETED // Finished successfully
  FAILED // Failed with error
  SKIPPED // Skipped (e.g., due to condition)
  ROLLED_BACK // Rolled back
}

model AgentPlan {
  id             String  @id @default(cuid())
  organizationId String
  workspaceId    String? // Workspace scoping (null = org-wide plan)
  conversationId String // Link to AgentConversation
  userId         String

  name        String // Short name for the plan
  description String          @db.Text // Full description of what the plan does
  status      AgentPlanStatus @default(DRAFT)

  currentStep Int @default(0) // Current step index
  totalSteps  Int // Total number of steps

  result Json? // Final result data
  error  String? // Error message if failed

  // Timestamps
  createdAt   DateTime  @default(now())
  startedAt   DateTime? // When execution started
  completedAt DateTime? // When execution finished

  // Relations
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps        AgentPlanStep[]

  @@index([organizationId, status])
  @@index([conversationId])
  @@index([userId])
  @@index([workspaceId])
}

model AgentPlanStep {
  id         String @id @default(cuid())
  planId     String
  stepNumber Int // 0-indexed step number

  toolName    String // Name of the tool to execute
  toolInput   Json // Tool input parameters
  description String // Human-readable description of what this step does

  dependsOn String[] // Step IDs this step depends on (must complete first)

  status AgentPlanStepStatus @default(PENDING)
  result Json? // Result data from tool execution
  error  String? // Error message if failed

  // Rollback support
  canRollback       Boolean @default(false)
  rollbackToolName  String? // Tool to call for rollback
  rollbackToolInput Json? // Input for rollback tool
  rolledBack        Boolean @default(false)

  // Timestamps
  startedAt   DateTime?
  completedAt DateTime?

  // Relations
  plan AgentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, stepNumber])
  @@index([planId])
  @@index([status])
}

// ============================================================================
// GLOBAL VARIABLES (Policy Condition Context)
// ============================================================================

enum GlobalVariableFieldType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  STRING_ARRAY
  NUMBER_ARRAY
}

model GlobalVariableNamespace {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String? // null = global (org-wide), otherwise workspace-scoped
  name           String // e.g., "COMPANY", "LIMITS"
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields       GlobalVariableField[]

  // Namespace names must be unique within the same scope (global or workspace)
  @@unique([organizationId, workspaceId, name])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([workspaceId])
}

model GlobalVariableField {
  id          String                  @id @default(cuid())
  namespaceId String
  name        String // e.g., "creationDate", "maxUsers"
  description String?
  fieldType   GlobalVariableFieldType
  value       Json
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  namespace GlobalVariableNamespace @relation(fields: [namespaceId], references: [id], onDelete: Cascade)

  @@unique([namespaceId, name])
  @@index([namespaceId])
}

// ============================================================================
// SESSION CONTEXT
// ============================================================================

enum SessionStatus {
  ACTIVE
  EXPIRED
  TERMINATED // Admin-initiated termination
}

enum SessionContextEntryType {
  USER_INTENT
  DATA_ACCESSED
  RISK_SIGNAL
  TOOL_OUTCOME
  AGENT_OBSERVATION
}

model Session {
  id                String  @id @default(cuid())
  organizationId    String

  // Workspace scoping (null = org-wide session)
  workspaceId String?

  externalSessionId String // Maps to existing sessionId string from MCP
  userId            String?
  agentId           String?

  status         SessionStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastActivityAt DateTime      @default(now())
  expiresAt      DateTime // 24 hours from creation by default

  // Termination tracking
  terminatedAt DateTime? // When the session was terminated
  terminatedBy String? // Admin user ID who terminated

  // Aggregated context
  contextSummary String? // Rolling LLM-generated summary
  toolCallCount  Int     @default(0)

  // Relations
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  contextEntries SessionContextEntry[]

  @@unique([organizationId, externalSessionId])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([expiresAt])
  @@index([status])
}

model SessionContextEntry {
  id        String                  @id @default(cuid())
  sessionId String
  entryType SessionContextEntryType
  createdAt DateTime                @default(now())

  key        String // e.g., "user_intent", "risk_signal", "data_sensitivity"
  value      Json
  summary    String? // LLM-generated summary
  importance Float   @default(0.5) // 0.0-1.0 for pruning

  sourceToolName String?
  expiresAt      DateTime?

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, entryType])
  @@index([importance])
}

// ============================================================================
// POLICY CONDITIONS (Deterministic Evaluation)
// ============================================================================

// Tracks historical parameter values for condition builder suggestions
// Values are shared across all tools from the same MCP server by parameter key
model ToolParamValue {
  id              String   @id @default(cuid())
  organizationId  String
  serverId        String // MCP server ID - values are shared across all tools on this server
  toolName        String? // For reference/auditing only (not used in unique constraint)
  parameterKey    String // e.g., "recipient", "query", "page_id"
  parameterValue  String
  displayLabel    String? // Human-readable label (e.g., "Q1 Planning" for page_abc123)
  occurrenceCount Int      @default(1)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mcpServer    McpServer    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // Unique per org+server+key+value - allows same key across servers
  @@unique([organizationId, serverId, parameterKey, parameterValue])
  @@index([organizationId, serverId])
  @@index([organizationId, serverId, parameterKey])
  @@index([lastSeenAt])
}

// Organization-level settings for policy features
model OrganizationSettings {
  id                        String        @id @default(cuid())
  organizationId            String        @unique
  defaultTimezone           String        @default("UTC")
  paramHistoryRetentionDays Int           @default(90)
  auditLogRetentionDays     Int           @default(90) // Days to retain audit logs (0 = indefinite)
  defaultConditionMode      ConditionMode @default(SIMPLE) // Default mode when creating new policies
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  // LLM Provider Configuration (org-level fallback)
  llmProvider    String  @default("auto") // auto|gemini|claude|openai|ollama|lmstudio|custom
  llmModel       String? // Override default model
  llmApiKey      String? // Encrypted API key (self-hosted mode)
  llmBaseUrl     String? // Custom endpoint URL
  llmMaxTokens   Int     @default(4096)
  llmTemperature Float   @default(0.7)

  // Feature discovery settings
  featureTipsEnabled   Boolean @default(true)
  monthlyDigestEnabled Boolean @default(true)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============================================================================
// LLM USAGE TRACKING (Admin Agent)
// ============================================================================

model LlmUsageLog {
  id             String  @id @default(cuid())
  organizationId String
  sessionId      String?

  provider String // gemini|claude|openai|ollama|lmstudio|custom
  model    String

  inputTokens  Int
  outputTokens Int
  totalTokens  Int

  estimatedCostCents Int? // null for local providers

  requestType String? // agent|policy|chat|etc
  createdAt   DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, provider])
}

// ============================================================================
// ADMIN MCP CONFIRMATION (Admin MCP Server)
// ============================================================================

enum AdminMcpConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

model AdminMcpConfirmation {
  id             String  @id @default(cuid())
  organizationId String
  workspaceId    String?

  // Source identification
  mcpSessionId String
  adminUserId  String

  // Tool details
  toolName  String // e.g., "admin_create_policy"
  toolInput Json // Full validated input
  scope     String // AdminMcpScope enum value

  // Human-readable
  description String // "Create ALLOW policy for role:admin on github::*"
  riskLevel   String // LOW, MEDIUM, HIGH

  // Status
  status    AdminMcpConfirmationStatus @default(PENDING)
  expiresAt DateTime

  // Resolution
  confirmedAt     DateTime?
  confirmedBy     String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  // Execution
  executedAt DateTime?
  result     Json?
  error      String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  adminUser    User         @relation("AdminMcpRequestedBy", fields: [adminUserId], references: [id], onDelete: Cascade)
  confirmer    User?        @relation("AdminMcpConfirmedBy", fields: [confirmedBy], references: [id], onDelete: SetNull)
  rejecter     User?        @relation("AdminMcpRejectedBy", fields: [rejectedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, workspaceId])
  @@index([mcpSessionId])
  @@index([adminUserId])
  @@index([expiresAt])
}

// ============================================================================
// ENTERPRISE WORKSPACES
// ============================================================================

enum OrgRole {
  OWNER // Full org control, can manage other owners
  MEMBER // Standard org member, access via workspaces
}

enum WorkspaceMemberRole {
  MEMBER // Standard workspace member
  ADMIN // Workspace admin, can manage workspace resources
}

enum OwnershipTransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum PolicyProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OwnerRecoveryStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CANCELLED
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String // URL-friendly identifier (lowercase, hyphenated)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Soft delete fields
  deletedAt DateTime?
  deletedBy String?

  // Relations
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members                  WorkspaceMember[]
  policies                 Policy[]
  mcpServers               McpServer[]
  agents                   Agent[]
  globalVariableNamespaces GlobalVariableNamespace[]
  adminActionLogs          AdminActionLog[]
  policyExceptionRequests  PolicyExceptionRequest[]
  permissionRequests       PermissionRequest[]
  workspaceMcpConfigs      WorkspaceMcpConfig[]
  workspaceMcpOAuthTokens  WorkspaceMcpOAuthToken[]

  // Workspace chat relations
  chatSettings      WorkspaceChatSettings?
  chatConversations WorkspaceChatConversation[]
  chatUsage         WorkspaceChatUsage[]
  userLlmConfigs    UserLLMConfig[]

  // Audit logs scoped to this workspace
  auditLogs AuditLogEntry[]

  // Sensitive tool flags scoped to this workspace
  sensitiveToolFlags         SensitiveToolFlag[]
  sensitiveApprovalRequests  SensitiveFlagApprovalRequest[]

  // Admin MCP confirmations scoped to this workspace
  adminMcpConfirmations AdminMcpConfirmation[]

  // Agent plans scoped to this workspace
  agentPlans AgentPlan[]

  // Agent confirmations scoped to this workspace
  agentConfirmations AgentConfirmation[]

  // Feature discovery & notifications
  workspaceFeatureTipsSettings WorkspaceFeatureTipsSettings?
  userFeatureTipsSettings      UserFeatureTipsSettings[]

  // Policy tags scoped to this workspace
  policyTags PolicyTag[]

  // Webhook endpoints scoped to this workspace
  webhookEndpoints WebhookEndpoint[]

  // Sessions scoped to this workspace
  sessions Session[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(MEMBER)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model OrgOwner {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  addedAt        DateTime @default(now())
  addedBy        String? // User ID who added this owner (null for initial owner)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrgOwnership", fields: [userId], references: [id], onDelete: Cascade)
  addedByUser  User?        @relation("OrgOwnerAddedBy", fields: [addedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([addedBy])
}

model OwnershipTransfer {
  id             String                  @id @default(cuid())
  organizationId String
  fromUserId     String // Current owner initiating transfer
  toUserId       String // User receiving ownership
  status         OwnershipTransferStatus @default(PENDING)
  expiresAt      DateTime // Transfer expires if not accepted
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  // Resolution
  resolvedAt DateTime?
  resolvedBy String? // User who resolved (accepted/declined)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromUser     User         @relation("OwnershipTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User         @relation("OwnershipTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([toUserId, status])
  @@index([expiresAt])
}

model OrgWidePolicyProposal {
  id             String @id @default(cuid())
  organizationId String
  workspaceId    String // Workspace admin proposing the policy
  proposedById   String // User who proposed

  // Proposed policy data
  matchers      String[]
  toolPatterns  String[]
  effect        PolicyEffect
  description   String
  conditions    Json?
  justification String // Why this org-wide policy is needed

  status    PolicyProposalStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // Resolution
  reviewedAt      DateTime?
  reviewedBy      String? // Org owner who reviewed
  reviewNote      String?
  createdPolicyId String? // Policy ID if approved

  // Relations
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposedBy    User         @relation("PolicyProposalProposedBy", fields: [proposedById], references: [id], onDelete: Cascade)
  reviewer      User?        @relation("PolicyProposalReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  createdPolicy Policy?      @relation("PolicyProposalCreatedPolicy", fields: [createdPolicyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([workspaceId])
  @@index([proposedById])
}

model OwnerRecoveryRequest {
  id                 String              @id @default(cuid())
  organizationId     String
  requestedByEmail   String // Support agent email
  requestedByName    String?
  requestedReason    String
  supportTicketId    String?
  targetUserEmail    String // User to become owner
  targetUserId       String?
  verificationToken  String              @unique
  verificationMethod String              @default("email")
  verifiedAt         DateTime?
  status             OwnerRecoveryStatus @default(PENDING)
  expiresAt          DateTime // 72 hours
  approvedAt         DateTime?
  approvedBy         String?
  deniedAt           DateTime?
  deniedBy           String?
  deniedReason       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([verificationToken])
}

// ============================================================================
// POLICY EXCEPTION REQUESTS
// ============================================================================

enum PolicyExceptionType {
  PROPOSAL // New global policy proposal
  REMOVAL_REQUEST // Request to remove a global policy
  WORKSPACE_EXCEPTION // Request workspace-specific exception
}

enum PolicyExceptionStatus {
  PENDING
  APPROVED
  DENIED
  WITHDRAWN
}

// ============================================================================
// WORKSPACE CHAT (AI Chatbot)
// ============================================================================

enum LLMProvider {
  CLAUDE
  OPENAI
  GEMINI
}

enum ChatMessageRole {
  USER
  ASSISTANT
  TOOL_USE
  TOOL_RESULT
  PERMISSION_REQUEST
}

model PolicyExceptionRequest {
  id             String              @id @default(cuid())
  organizationId String
  workspaceId    String // Requesting workspace
  policyId       String? // Target policy (null for new proposals)
  requestType    PolicyExceptionType
  requestedById  String

  // For PROPOSAL: the proposed policy details
  proposedMatchers     String[]
  proposedToolPatterns String[]
  proposedEffect       PolicyEffect?
  proposedDescription  String?

  // Request details
  justification String // Why they need this

  // Status
  status     PolicyExceptionStatus @default(PENDING)
  reviewedAt DateTime?
  reviewedBy String?
  reviewNote String?

  // If approved, the resulting policy/exception
  resultPolicyId String? // Created/modified policy

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policy       Policy?      @relation("PolicyExceptionTarget", fields: [policyId], references: [id], onDelete: SetNull)
  requestedBy  User         @relation("PolicyExceptionRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("PolicyExceptionReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  resultPolicy Policy?      @relation("PolicyExceptionResult", fields: [resultPolicyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([workspaceId])
  @@index([policyId])
  @@index([requestedById])
}

// ============================================================================
// WORKSPACE CHAT MODELS
// ============================================================================

model WorkspaceChatSettings {
  id                  String       @id @default(cuid())
  workspaceId         String       @unique
  enabled             Boolean      @default(true)
  defaultLlmProvider  LLMProvider?
  defaultLlmModel     String?
  systemPrompt        String?      @db.Text
  monthlyMessageQuota Int?
  monthlyTokenQuota   Int?
  adminChatVisibility Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UserLLMConfig {
  id                   String      @id @default(cuid())
  userId               String
  workspaceId          String
  provider             LLMProvider
  apiKey               String // Encrypted
  model                String?
  alwaysAllowTools     String[]    @default([])
  skipToolConfirmation Boolean     @default(false) // When true, skip confirmation for all tools
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model WorkspaceChatConversation {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  WorkspaceChatMessage[]

  @@index([workspaceId, userId])
  @@index([createdAt])
}

model WorkspaceChatMessage {
  id                  String          @id @default(cuid())
  conversationId      String
  role                ChatMessageRole
  content             String          @db.Text
  toolName            String?
  toolInput           Json?
  toolResult          Json?
  permissionRequestId String?
  tokenCount          Int?
  createdAt           DateTime        @default(now())

  conversation      WorkspaceChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  permissionRequest PermissionRequest?        @relation(fields: [permissionRequestId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([createdAt])
}

model WorkspaceChatUsage {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  month        DateTime // First of month
  messageCount Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, month])
  @@index([workspaceId])
  @@index([userId])
}

// ============================================================================
// USER ONBOARDING
// ============================================================================

model UserOnboarding {
  id     String @id @default(cuid())
  userId String @unique

  currentTourId  String? // null = no active tour
  currentStep    Int      @default(0)
  completedTours String[] @default([])
  completedSteps String[] @default([]) // "tourId:stepId" format

  dismissed    Boolean @default(false)
  showAdvanced Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// FEATURE DISCOVERY & NOTIFICATIONS
// ============================================================================

enum FeatureTipsSetting {
  ON
  OFF
  INHERIT
}

enum DismissType {
  NOT_INTERESTED // Permanent - never show again
  REMIND_LATER // Show again after remindAfter date
}

model WorkspaceFeatureTipsSettings {
  id          String             @id @default(cuid())
  workspaceId String             @unique
  setting     FeatureTipsSetting @default(INHERIT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UserFeatureTipsSettings {
  id          String             @id @default(cuid())
  userId      String
  workspaceId String
  setting     FeatureTipsSetting @default(INHERIT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model FeatureTipOrgOverride {
  id             String   @id @default(cuid())
  organizationId String
  tipId          String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, tipId])
  @@index([organizationId])
}

model FeatureTipDismissal {
  id             String      @id @default(cuid())
  userId         String
  organizationId String
  tipId          String
  dismissType    DismissType
  dismissedAt    DateTime    @default(now())
  remindAfter    DateTime? // For REMIND_LATER, set to dismissedAt + 30 days

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, tipId])
  @@index([userId])
  @@index([organizationId])
}

model EmailDigestPreference {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model EmailDigestLog {
  id             String   @id @default(cuid())
  organizationId String
  recipientCount Int
  sentAt         DateTime @default(now())
  periodStart    DateTime
  periodEnd      DateTime
  status         String // SENT, FAILED, PARTIAL

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sentAt])
}

model MilestoneAchievement {
  id             String   @id @default(cuid())
  organizationId String
  milestoneId    String
  achievedAt     DateTime @default(now())
  notifiedVia    String[] // ['toast', 'email']

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, milestoneId])
  @@index([organizationId])
}

model MilestoneNotificationPreference {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  toastEnabled   Boolean  @default(true)
  emailEnabled   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}
