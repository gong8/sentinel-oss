// SENTINEL Database Schema
// This schema defines the data models for the SENTINEL control plane

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin MCP Configuration
  adminMcpEnabled         Boolean  @default(true)
  adminMcpEnabledScopes   String[] @default([]) // ["POLICIES", "USERS", etc.]
  adminMcpAllowedAdmins   String[] @default([]) // User IDs (empty = all admins)
  adminMcpRateLimitPerMin Int      @default(30)
  adminMcpConfirmationTtl Int      @default(300) // seconds, default 5 min

  // Relations
  users                    User[]
  mcpServers               McpServer[]
  policies                 Policy[]
  policyTests              PolicyTest[]
  policyAssertions         PolicyAssertion[]
  auditLogEntries          AuditLogEntry[]
  agents                   Agent[]
  roles                    Role[]
  adminActionLogs          AdminActionLog[]
  oauthClientRegistrations OAuthClientRegistration[]
  oauthStates              OAuthState[]
  orgMcpOAuthTokens        OrgMcpOAuthToken[]

  // Sensitive flags and webhooks
  sensitiveToolFlags        SensitiveToolFlag[]
  sensitiveApprovalRequests SensitiveFlagApprovalRequest[]
  sensitiveRateLimitUsage   SensitiveFlagRateLimitUsage[]
  webhookEndpoints          WebhookEndpoint[]

  // Publisher registry (Agent Identity Attestation)
  publisherRegistries PublisherRegistry[]

  // A2A credentials
  a2aCredentials A2ACredential[]

  // Agent assistant conversations
  agentConversations AgentConversation[]
  agentConfirmations AgentConfirmation[]

  // Session context for policy evaluation
  sessions Session[]

  // Policy conditions (deterministic evaluation)
  toolParamValues ToolParamValue[]
  settings        OrganizationSettings?

  // LLM usage tracking
  llmUsageLogs LlmUsageLog[]

  // Agent memory and planning
  agentMemories       AgentMemory[]
  agentToolUsages     AgentToolUsage[]
  toolEmbeddingCaches ToolEmbeddingCache[]
  agentPlans          AgentPlan[]

  // Admin MCP confirmations
  adminMcpConfirmations AdminMcpConfirmation[]

  // Global variables for policy conditions
  globalVariableNamespaces GlobalVariableNamespace[]

  // Enterprise workspaces
  workspaces              Workspace[]
  orgOwners               OrgOwner[]
  ownershipTransfers      OwnershipTransfer[]
  policyProposals         OrgWidePolicyProposal[]
  ownerRecoveryRequests   OwnerRecoveryRequest[]
  policyExceptionRequests PolicyExceptionRequest[]

  // Feature discovery & notifications
  featureTipOrgOverrides           FeatureTipOrgOverride[]
  featureTipDismissals             FeatureTipDismissal[]
  emailDigestPreferences           EmailDigestPreference[]
  emailDigestLogs                  EmailDigestLog[]
  milestoneAchievements            MilestoneAchievement[]
  milestoneNotificationPreferences MilestoneNotificationPreference[]

  // Policy tags
  policyTags PolicyTag[]

  @@index([createdAt])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  accessToken    String   @unique @default(cuid())
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Activity tracking
  lastActivityAt DateTime? // Last API/MCP request timestamp

  // Soft delete fields
  deletedAt DateTime? // NULL = active, non-NULL = soft deleted
  deletedBy String? // Admin user ID who deleted this user

  // Relations
  organization              Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles                 UserRole[]
  mcpConfigs                UserMcpConfig[]
  auditLogEntries           AuditLogEntry[]
  permissionRequests        PermissionRequest[]
  adminActions              AdminActionLog[] // Actions performed by this admin
  orgOAuthConnections       OrgMcpOAuthToken[]       @relation("OrgOAuthConnector")
  workspaceOAuthConnections WorkspaceMcpOAuthToken[] @relation("WorkspaceOAuthConnector")

  // Sensitive flags
  createdSensitiveFlags SensitiveToolFlag[]            @relation("SensitiveFlagCreator")
  approvalRequestsMade  SensitiveFlagApprovalRequest[] @relation("ApprovalRequestor")
  approvalsGiven        SensitiveFlagApprovalRequest[] @relation("ApprovalApprover")

  // Agent assistant conversations
  agentConversations AgentConversation[]

  // Admin MCP confirmations
  adminMcpRequestedConfirmations AdminMcpConfirmation[] @relation("AdminMcpRequestedBy")
  adminMcpConfirmedConfirmations AdminMcpConfirmation[] @relation("AdminMcpConfirmedBy")
  adminMcpRejectedConfirmations  AdminMcpConfirmation[] @relation("AdminMcpRejectedBy")

  // Enterprise workspaces
  orgRole                   OrgRole                  @default(MEMBER)
  workspaceMemberships      WorkspaceMember[]
  orgOwnership              OrgOwner[]               @relation("OrgOwnership")
  orgOwnersAdded            OrgOwner[]               @relation("OrgOwnerAddedBy")
  ownershipTransfersFrom    OwnershipTransfer[]      @relation("OwnershipTransferFrom")
  ownershipTransfersTo      OwnershipTransfer[]      @relation("OwnershipTransferTo")
  proposedPolicies          OrgWidePolicyProposal[]  @relation("PolicyProposalProposedBy")
  reviewedPolicyProposals   OrgWidePolicyProposal[]  @relation("PolicyProposalReviewedBy")
  policyExceptionsRequested PolicyExceptionRequest[] @relation("PolicyExceptionRequestedBy")
  policyExceptionsReviewed  PolicyExceptionRequest[] @relation("PolicyExceptionReviewedBy")

  // Workspace chat relations
  llmConfigs                 UserLLMConfig[]
  workspaceChatConversations WorkspaceChatConversation[]
  workspaceChatUsage         WorkspaceChatUsage[]

  // Agent memory and planning
  agentMemories   AgentMemory[]
  agentToolUsages AgentToolUsage[]
  agentPlans      AgentPlan[]

  // Onboarding state
  onboarding UserOnboarding?

  // Feature discovery & notifications
  userFeatureTipsSettings          UserFeatureTipsSettings[]
  featureTipDismissals             FeatureTipDismissal[]
  emailDigestPreferences           EmailDigestPreference[]
  milestoneNotificationPreferences MilestoneNotificationPreference[]

  @@index([organizationId])
  @@index([email])
  @@index([accessToken])
  @@index([organizationId, deletedAt])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isAdmin        Boolean  @default(false) // Special flag - admin roles bypass normal checks
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Soft delete fields
  deletedAt DateTime? // NULL = active, non-NULL = soft deleted
  deletedBy String? // Admin user ID who deleted this role

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isAdmin])
  @@index([organizationId, deletedAt])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ============================================================================
// PROTOCOL ENUMS (shared MCP/A2A)
// ============================================================================

enum ProtocolType {
  MCP
  A2A
}

enum AgentCardSource {
  URL // Card auto-fetched from agentCardUrl
  MANUAL // Card uploaded directly by admin
}

enum AuthType {
  NONE
  API_KEY
  OAUTH
  OIDC // OpenID Connect (for A2A)
}

enum TransportType {
  HTTP
  STDIO
  SSE
  WEBSOCKET
}

model Agent {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())

  // Soft delete fields
  deletedAt DateTime? // NULL = active, non-NULL = soft deleted
  deletedBy String? // Admin user ID who deleted this agent

  // Protocol type (MCP or A2A)
  protocolType ProtocolType @default(MCP)

  // Identity attestation fields (Phase 2a)
  signatureVerified   Boolean   @default(false)
  signatureVerifiedAt DateTime?
  publicKeyUrl        String? // JWKS endpoint URL
  publicKeyCache      Json? // Cached JWKS content
  publicKeyCachedAt   DateTime?

  // A2A-specific fields (Phase 2b)
  cardSource         AgentCardSource @default(URL)
  agentCardUrl       String? // For URL: required. For MANUAL: optional (explicit refresh)
  endpointUrl        String? // Extracted from card.url for easy querying
  agentCardCache     Json? // Full Agent Card JSON
  agentCardFetchedAt DateTime? // When last fetched/uploaded
  agentCardHash      String? // SHA-256 for change detection

  // Workspace scoping (null = org-wide agent)
  workspaceId String?

  // Relations
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  auditLogEntries AuditLogEntry[]
  a2aCredential   A2ACredential?

  // Sensitive flags
  sensitiveOverrides        SensitiveFlagAgentOverride[]
  sensitiveApprovalRequests SensitiveFlagApprovalRequest[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, protocolType])
  @@index([workspaceId])
}

// ============================================================================
// A2A CREDENTIALS (Agent-to-Agent Protocol)
// ============================================================================

model A2ACredential {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String   @unique
  authType       AuthType
  credentials    String // Encrypted JSON blob
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ============================================================================
// PUBLISHER REGISTRY (Agent Identity Attestation)
// ============================================================================

model PublisherRegistry {
  id             String   @id @default(cuid())
  organizationId String
  name           String // Publisher name (e.g., "Anthropic")
  publicKey      String // PEM-encoded public key (encrypted)
  keyAlgorithm   String // RS256, ES256, EdDSA, etc.
  keyFingerprint String // SHA-256 fingerprint for quick lookup
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Soft delete fields
  deletedAt DateTime?
  deletedBy String?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, keyFingerprint])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

// ============================================================================
// MCP SERVER ENTITIES
// ============================================================================

model McpServer {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  url            String
  authType       McpAuthType
  apiKey         String? // Encrypted API key (org-level)
  credentials    Json? // Encrypted JSON credentials (org-level)
  authConfig     Json? // Template config for API_KEY auth: { headerTemplates: {...}, queryTemplates: {...} }

  // Transport configuration
  transportType TransportType @default(HTTP)

  // STDIO transport config (for local subprocess MCP servers)
  stdioCommand    String? // Command to execute (e.g., "python", "node")
  stdioArgs       Json? // Command arguments as JSON array
  stdioWorkingDir String? // Working directory for subprocess
  stdioEnv        String? // Encrypted environment variables JSON

  // WebSocket transport config
  wsReconnectMs Int? @default(5000) // Reconnect interval
  wsMaxRetries  Int? @default(3) // Max reconnection attempts
  wsHeartbeatMs Int? @default(30000) // Heartbeat interval

  trusted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete fields
  deletedAt DateTime? // NULL = active, non-NULL = soft deleted
  deletedBy String? // Admin user ID who deleted this server

  // Workspace scoping (null = org-wide server)
  workspaceId String?

  // Tool classification status
  classificationStatus    ClassificationStatus @default(NOT_STARTED)
  classificationStartedAt DateTime?
  classificationError     String?

  // Relations
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace               Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  tools                   McpTool[]
  userConfigs             UserMcpConfig[]
  workspaceConfigs        WorkspaceMcpConfig[]
  oauthClientRegistration OAuthClientRegistration?
  orgOAuthToken           OrgMcpOAuthToken?
  workspaceOAuthTokens    WorkspaceMcpOAuthToken[]
  toolParamValues         ToolParamValue[]

  @@index([organizationId])
  @@index([trusted])
  @@index([organizationId, deletedAt])
  @@index([workspaceId])
}

enum McpAuthType {
  NONE
  OAUTH
  API_KEY
}

enum ClassificationStatus {
  NOT_STARTED // No classification attempted yet
  IN_PROGRESS // Currently classifying tools
  COMPLETED // All tools classified successfully
  FAILED // Classification failed
}

model McpTool {
  id           String   @id @default(cuid())
  mcpServerId  String
  name         String
  description  String?
  inputSchema  Json? // JSON Schema from MCP tool definition (for condition building)
  discoveredAt DateTime @default(now())

  // Relations
  mcpServer      McpServer              @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  classification McpToolClassification?

  @@unique([mcpServerId, name])
  @@index([mcpServerId])
}

// ============================================================================
// TOOL CLASSIFICATION (LLM-based risk assessment)
// ============================================================================

enum ToolRiskLevel {
  LOW // Read-only, no sensitive data
  MEDIUM // May access sensitive data
  HIGH // Modifies important data
  CRITICAL // Deletes data, executes code, accesses secrets
}

enum ToolAccessType {
  READ
  WRITE
  READ_WRITE
}

enum ClassificationSource {
  LLM_AUTO // Classified automatically by LLM
  USER_MANUAL // Overridden manually by user
}

model McpToolClassification {
  id        String @id @default(cuid())
  mcpToolId String @unique

  riskLevel  ToolRiskLevel?
  accessType ToolAccessType?
  useCases   String?

  source         ClassificationSource @default(LLM_AUTO)
  llmConfidence  Float?
  llmRawResponse Json?

  // Override tracking
  overriddenAt       DateTime?
  overriddenBy       String?
  originalRiskLevel  ToolRiskLevel?
  originalAccessType ToolAccessType?
  originalUseCases   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mcpTool McpTool @relation(fields: [mcpToolId], references: [id], onDelete: Cascade)

  @@index([mcpToolId])
  @@index([riskLevel])
  @@index([accessType])
}

// OAuth client registration per organization per MCP server
// Stores DCR results or manually configured OAuth credentials
model OAuthClientRegistration {
  id             String @id @default(cuid())
  organizationId String
  mcpServerId    String @unique

  // Client credentials (encrypted with AES-256-GCM)
  clientId     String
  clientSecret String // Encrypted

  // Redirect URI used during registration (must match for token exchange)
  redirectUri String? // Stored to ensure consistency across environments

  // OAuth endpoints (discovered or manually configured)
  authorizationEndpoint String
  tokenEndpoint         String
  registrationEndpoint  String? // DCR endpoint (if available)
  revocationEndpoint    String? // Token revocation endpoint (if available)

  // Authorization server metadata
  scopesSupported     String[]
  grantTypesSupported String[]

  discoveredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mcpServer    McpServer    @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Temporary OAuth state for PKCE + CSRF protection
// Created when user initiates OAuth, consumed on callback
model OAuthState {
  id             String   @id @default(cuid())
  organizationId String
  state          String   @unique // CSRF token (cryptographically random)
  userId         String
  mcpServerId    String
  codeVerifier   String // PKCE code_verifier (64 random bytes base64url)
  resource       String // RFC 8707 resource URL (the MCP server URL)
  returnUrl      String? // URL to redirect to after OAuth completes (e.g., /admin/credentials)
  isOrgLevel     Boolean  @default(false) // True if connecting for org, false for personal
  workspaceId    String? // If set, tokens are stored at workspace level
  expiresAt      DateTime // 10 minute expiry
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([organizationId])
  @@index([expiresAt]) // For cleanup of expired states
}

model UserMcpConfig {
  id          String  @id @default(cuid())
  userId      String
  mcpServerId String
  apiKey      String? // Encrypted API key (user-level)
  credentials Json // Encrypted: legacy API keys / custom credentials

  // OAuth 2.1 token storage (all encrypted)
  accessToken     String? // Encrypted access token
  refreshToken    String? // Encrypted refresh token
  tokenType       String? // Usually "Bearer"
  tokenExpiresAt  DateTime? // When the access token expires
  tokenScope      String? // Granted OAuth scopes (space-separated)
  lastRefreshedAt DateTime? // When tokens were last refreshed

  authenticatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpServer McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@unique([userId, mcpServerId])
  @@index([userId])
  @@index([mcpServerId])
}

// Organization-level OAuth token storage
// When admin connects OAuth for the org, tokens are stored here
// Users inherit this connection unless they have personal tokens
model OrgMcpOAuthToken {
  id             String @id @default(cuid())
  organizationId String
  mcpServerId    String @unique // One org token per server

  // OAuth 2.1 token storage (all encrypted)
  accessToken     String // Encrypted access token
  refreshToken    String? // Encrypted refresh token
  tokenType       String    @default("Bearer")
  tokenExpiresAt  DateTime? // When the access token expires
  tokenScope      String? // Granted OAuth scopes
  lastRefreshedAt DateTime? // When tokens were last refreshed

  // Audit info
  connectedBy     String? // User ID of admin who connected (nullable for SetNull on user deletion)
  authenticatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mcpServer       McpServer    @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  connectedByUser User?        @relation("OrgOAuthConnector", fields: [connectedBy], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// Workspace-level credential storage for MCP servers
// Workspace admins can set credentials that apply to all users in the workspace
// Priority: Personal > Workspace > Organization
model WorkspaceMcpConfig {
  id          String  @id @default(cuid())
  workspaceId String
  mcpServerId String
  apiKey      String? // Encrypted API key (workspace-level)
  credentials Json? // Encrypted: custom credentials JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mcpServer McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, mcpServerId])
  @@index([workspaceId])
  @@index([mcpServerId])
}

// Workspace-level OAuth token storage
// Workspace admins can connect OAuth for their workspace
// Priority: Personal > Workspace > Organization
model WorkspaceMcpOAuthToken {
  id          String @id @default(cuid())
  workspaceId String
  mcpServerId String

  // OAuth 2.1 token storage (all encrypted)
  accessToken     String // Encrypted access token
  refreshToken    String? // Encrypted refresh token
  tokenType       String    @default("Bearer")
  tokenExpiresAt  DateTime? // When the access token expires
  tokenScope      String? // Granted OAuth scopes
  lastRefreshedAt DateTime? // When tokens were last refreshed

  // Audit info
  connectedBy     String? // User ID of admin who connected
  authenticatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mcpServer       McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  connectedByUser User?     @relation("WorkspaceOAuthConnector", fields: [connectedBy], references: [id], onDelete: SetNull)

  @@unique([workspaceId, mcpServerId])
  @@index([workspaceId])
  @@index([mcpServerId])
}

// ============================================================================
// POLICY ENTITIES
// ============================================================================

model Policy {
  id             String       @id @default(cuid())
  organizationId String
  slug           String
  matchers       String[] // e.g., ["role:admin", "user:alice@example.com"]
  toolPatterns   String[] // e.g., ["notion.com::createPage", "github.com::*"]
  effect         PolicyEffect
  description    String
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Deterministic conditions (Phase 1: Policy Architecture)
  conditions Json? // PolicyCondition[] for simple mode (flat array with AND logic)

  // Tree-based conditions with AND/OR nesting (Phase 3: Chip Builder)
  conditionsTree Json? // ConditionGroupNode - full tree structure with AND/OR logic

  // Advanced conditions (Phase 2: SQL-like expression language)
  conditionMode       ConditionMode @default(SIMPLE)
  conditionExpression Json? // { expression: string, ast: object, version: number }

  // Soft delete fields
  deletedAt DateTime? // NULL = active, non-NULL = soft deleted
  deletedBy String? // Admin user ID who deleted this policy

  // Workspace scoping (null = org-wide policy)
  workspaceId String?

  // Relations
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace               Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  linkedRequests          PermissionRequest[] // Requests that were resolved by this policy
  createdFromProposals    OrgWidePolicyProposal[]  @relation("PolicyProposalCreatedPolicy")
  exceptionRequestsTarget PolicyExceptionRequest[] @relation("PolicyExceptionTarget")
  exceptionRequestsResult PolicyExceptionRequest[] @relation("PolicyExceptionResult")
  tags                    PolicyTagAssignment[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([enabled])
  @@index([organizationId, deletedAt])
  @@index([workspaceId])
}

enum ConditionMode {
  SIMPLE // Visual condition builder with flat array
  ADVANCED // SQL-like expression language
}

enum PolicyEffect {
  ALLOW
  DENY
}

// ============================================================================
// POLICY TAGS
// ============================================================================

model PolicyTag {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String? // null = global (org-wide), otherwise workspace-scoped
  name           String
  description    String?
  color          String    @default("#6366f1") // Default indigo
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policies     PolicyTagAssignment[]

  @@unique([organizationId, workspaceId, name]) // Unique name per workspace (or global)
  @@index([organizationId])
  @@index([workspaceId])
}

model PolicyTagAssignment {
  id          String   @id @default(cuid())
  policyId    String
  policyTagId String
  createdAt   DateTime @default(now())

  policy    Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyTag PolicyTag @relation(fields: [policyTagId], references: [id], onDelete: Cascade)

  @@unique([policyId, policyTagId])
  @@index([policyId])
  @@index([policyTagId])
}

// ============================================================================
// POLICY TEST ENTITIES
// ============================================================================

model PolicyTest {
  id             String  @id @default(cuid())
  organizationId String
  createdById    String // Admin who created the test
  toolName       String
  userId         String? // User being tested
  agentId        String? // Agent being tested

  // Test result snapshot
  decision      String // ALLOWED or DENIED
  justification String?

  // Policy snapshot at test time
  matchedPolicyIds    String[] // Policies that matched
  allEnabledPolicyIds String[] // All enabled policies at test time
  policySnapshot      Json // Full snapshot of all policies

  // Context snapshot
  userEmail String?
  userRoles String[]
  agentName String?

  // Tool invocation details (for condition testing)
  toolParameters   Json? // The parameters used in the test
  contextOverrides Json? // { hourOfDay?, dayOfWeek?, sourceIp?, timestamp? }
  extractedContext Json? // { sql?, github?, file? }
  extractedMode    String? // 'auto' | 'manual'

  createdAt DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdById])
  @@index([createdAt])
}

// ============================================================================
// POLICY ASSERTION ENTITIES
// ============================================================================

enum AssertionSource {
  MANUAL
  PLAYGROUND
  AUDIT_LOG
}

enum AssertionContextType {
  USER
  AGENT
  ROLE
  WILDCARD
}

model PolicyAssertion {
  id             String @id @default(cuid())
  organizationId String
  createdById    String // Admin who created

  // Identification
  name        String // Human-readable name
  description String? // Optional longer description

  // Test definition
  toolPattern String // e.g., "github.com::createPR" or "github.com::*"
  contextType AssertionContextType // What context to test against
  userId      String? // For USER context
  agentId     String? // For AGENT context
  roleName    String? // For ROLE context (test all users with this role)

  // Expected outcome
  expectedDecision String // "ALLOWED" or "DENIED"

  // Tool invocation details (for condition testing)
  toolParameters   Json? // Specific params to test with
  contextOverrides Json? // Fixed context values for assertion
  extractedContext Json? // Fixed extracted values
  extractedMode    String? // 'auto' | 'manual'
  parameterMode    String  @default("exact") // 'exact' | 'subset' | 'ignore'

  // Source tracking
  source   AssertionSource @default(MANUAL)
  sourceId String? // PlaygroundTest ID or AuditLogEntry ID

  // Last run status
  lastRunAt            DateTime?
  lastRunPassed        Boolean? // true = actual matched expected
  lastRunDecision      String? // Actual decision from last run
  lastRunJustification String?
  lastRunPolicyIds     String[] // Policies that matched
  lastRunSubResults    Json? // For ROLE/wildcard: array of sub-results

  // Lifecycle
  enabled      Boolean  @default(true)
  failureCount Int      @default(0) // Historical failure count
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([enabled])
  @@index([lastRunPassed])
  @@index([source])
}

// ============================================================================
// AUDIT ENTITIES
// ============================================================================

model AuditLogEntry {
  id             String        @id @default(cuid())
  organizationId String
  userId         String?
  agentId        String?
  workspaceId    String? // Workspace context for filtering
  toolName       String // Fully qualified: "notion.com::createPage"
  parameters     Json
  decision       AuditDecision
  justification  String? // If denied, explains why
  policyIds      String[] // Policies that contributed to decision
  timestamp      DateTime      @default(now())

  // Policy snapshot at evaluation time
  matchedPolicyIds String[] // Policies that matched (subset of policyIds)
  policySnapshot   Json? // Full snapshot of all enabled policies at evaluation time
  userEmail        String? // User email at evaluation time (for historical accuracy)
  userRoles        String[] // User roles at evaluation time (for historical accuracy)
  agentName        String? // Agent name at evaluation time (for historical accuracy)

  // MCP server context (for display after server deletion)
  mcpServerName   String? // Friendly server name at evaluation time
  toolNameDisplay String? // Display format "ServerName::toolName"

  // Live approval tracking (for sensitive flags with REQUIRE_APPROVAL)
  approvalRequired       Boolean   @default(false) // True if tool required live approval
  approvalRequestId      String? // Link to SensitiveFlagApprovalRequest
  approvalStatus         String? // APPROVED, DENIED, EXPIRED, CANCELLED
  approvalDecidedBy      String? // User ID who decided
  approvalDecidedByEmail String? // Email for display
  approvalDecidedAt      DateTime? // When the decision was made

  // Pipeline and Evaluation Tree (for audit visualization)
  pipelineStage      String? // Final stage reached (REQUEST, SENTINEL_ENTRY, TRUST_CHECK, POLICY_CHECK, FLAG_CHECK, EXECUTE, SENTINEL_EXIT, LOG)
  interruptedAt      String? // Stage where processing stopped
  interruptionReason String? // Why it stopped

  // Stage results
  trustCheckPassed  Boolean? // Whether server trust check passed
  serverTrusted     Boolean? // Whether the MCP server was trusted
  policyCheckPassed Boolean? // Whether policy check passed
  flagCheckPassed   Boolean? // Whether flag check passed

  // Flag details
  matchedFlagIds String[] @default([]) // IDs of flags that matched
  flagBehaviors  String[] @default([]) // Behaviors of matched flags
  rateLimitHit   Boolean? // Whether a rate limit was hit

  // Full evaluation tree (PolicyEvaluationTree structure)
  evaluationTree Json? // Complete evaluation tree for visualization

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([agentId])
  @@index([timestamp])
  @@index([decision])
  @@index([toolName])
  @@index([userEmail]) // For filtering deleted users by email
  @@index([agentName]) // For filtering deleted agents by name
  @@index([workspaceId]) // For filtering by workspace
}

enum AuditDecision {
  ALLOWED
  DENIED
}

// ============================================================================
// PERMISSION REQUEST ENTITIES
// ============================================================================

enum PermissionRequestType {
  TOOL_ACCESS
  MCP_SERVER
  DENY_REMOVAL // Request removal of explicit DENY policy
}

model PermissionRequest {
  id             String                  @id @default(cuid())
  userId         String
  type           PermissionRequestType   @default(TOOL_ACCESS)
  status         PermissionRequestStatus @default(PENDING)
  reason         String
  toolNames      String[] // Tools being requested (for TOOL_ACCESS)
  data           Json? // Additional data (e.g., MCP server config for MCP_SERVER)
  reviewedBy     String? // Admin user ID who reviewed
  reviewedAt     DateTime?
  reviewNote     String?
  linkedPolicyId String? // Policy that resolved this request (for MODIFIED status)
  grantDiff      Json? // Diff between requested and granted (only for MODIFIED status)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  // Workspace scoping (null = org-wide request)
  workspaceId String?

  // Relations
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedPolicy Policy?    @relation(fields: [linkedPolicyId], references: [id], onDelete: SetNull)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  // Workspace chat messages that link to this permission request
  chatMessages WorkspaceChatMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([linkedPolicyId])
  @@index([workspaceId])
}

enum PermissionRequestStatus {
  PENDING
  APPROVED
  DENIED
  WITHDRAWN
  MODIFIED
}

// ============================================================================
// ADMIN ACTION LOG ENTITIES
// ============================================================================

model AdminActionLog {
  id             String            @id @default(cuid())
  organizationId String
  adminUserId    String? // Admin who performed the action (nullable for SetNull on user deletion)
  actionType     AdminActionType
  resourceType   AdminResourceType
  resourceId     String? // ID of the affected resource (null for bulk actions)
  resourceName   String? // Human-readable name of the resource (e.g., policy slug, user email)

  // Detailed action data
  actionDetails  Json // Flexible JSON for action-specific data
  beforeSnapshot Json? // Snapshot of resource before action (for updates/deletes)
  afterSnapshot  Json? // Snapshot of resource after action (for creates/updates)

  // Context and metadata
  ipAddress String? // IP address of admin (if available)
  userAgent String? // User agent string (if available)
  reason    String? // Optional reason/note for the action

  // MCP Source Identification
  source            AdminActionSource @default(UI)
  mcpSessionId      String?
  mcpToolName       String?
  confirmationId    String?
  confirmedByUserId String?
  confirmedAt       DateTime?

  // Workspace scoping (null = org-wide action)
  workspaceId String?

  // Request context
  requestHeaders     Json? // Sanitized HTTP headers (auth tokens stripped)
  referrer           String?
  sessionFingerprint String? // Hash of user agent + IP for session tracking
  requestPath        String? // API endpoint path

  // Change diff (computed at write time)
  changeDiff  Json? // { field: { before, after, changeType } }
  diffSummary String? // Human-readable: "Changed effect from ALLOW to DENY"

  // Related resources (with names preserved)
  relatedResources Json? // [{ type, id, name }]

  // Action flow tracking
  actionStage   String? // "initiated" | "confirmed" | "executed" | "completed" | "failed"
  correlationId String? // Group related actions (e.g., MCP confirmation flow)

  timestamp DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adminUser    User?        @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([adminUserId])
  @@index([actionType])
  @@index([resourceType])
  @@index([resourceId])
  @@index([timestamp])
  @@index([source])
  @@index([mcpSessionId])
  @@index([organizationId, workspaceId])
  @@index([correlationId])
  @@index([organizationId, resourceType, resourceId, timestamp])
}

