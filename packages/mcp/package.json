{
  "name": "@sentinel/mcp",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./transports": {
      "import": "./dist/transports/index.js",
      "types": "./dist/transports/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./session-manager": {
      "import": "./dist/session-manager.js",
      "types": "./dist/session-manager.d.ts"
    },
    "./mcp-client": {
      "import": "./dist/mcp-client.js",
      "types": "./dist/mcp-client.d.ts"
    }
  },
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "test:inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- pnpm exec vitest"
  },
  "dependencies": {
    "@sentinel/api": "workspace:*",
    "@sentinel/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@trpc/client": "^11.8.1",
    "ws": "^8.18.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@trpc/server": "^11.8.1",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.5.13",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
